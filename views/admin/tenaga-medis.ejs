<%- include('../partials/admin-layout-header') %>
<%- include('../partials/admin-sidebar') %>

<!-- Page Content -->
<div id="content">
    <%- include('../partials/admin-top-nav') %>

    <div class="main-content">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3>Kelola Tenaga Medis</h3>
            <a href="/admin/tenaga-medis/tambah" class="btn btn-success">
                <i class="fas fa-plus"></i> Tambah Tenaga Medis
            </a>
        </div>
        <hr>

        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Nama Lengkap</th>
                        <th>Username</th>
                        <th>Role</th>
                        <th>Spesialis</th>
                        <th>Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (staff && staff.length > 0) { %>
                        <% staff.forEach(person => { %>
                            <tr>
                                <td><%= person.nama_lengkap %></td>
                                <td><%= person.username %></td>
                                <td><%= person.role %></td>
                                <td><%= person.spesialis || '-' %></td>
                                <td>
                                    <a href="/admin/tenaga-medis/ubah/<%= person.id %>" class="btn btn-sm btn-warning">
                                        <i class="fas fa-edit"></i> Ubah
                                    </a>
                                    <form action="/admin/tenaga-medis/hapus/<%= person.id %>" method="POST" class="d-inline" onsubmit="return confirm('Apakah Anda yakin ingin menghapus tenaga medis ini?');">
                                        <button type="submit" class="btn btn-sm btn-danger">
                                            <i class="fas fa-trash"></i> Hapus
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" class="text-center">Belum ada data tenaga medis.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('../partials/admin-layout-footer') %>
