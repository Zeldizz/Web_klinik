<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Klinik AL-Furqon</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/boxicons/2.1.0/css/boxicons.min.css" />
</head>
<body class="login-page">

    <div class="login-container">
        <!-- Kolom Kiri - Branding -->
        <div class="login-branding-panel">
            <div class="branding-content">
                <i class='bx bxs-clinic brand-icon'></i>
                <h1>Selamat Datang Kembali</h1>
                <p>Silakan masuk untuk mengakses jadwal, membuat reservasi, dan melihat riwayat kesehatan Anda di Klinik AL-Furqon.</p>
            </div>
        </div>

        <!-- Kolom Kanan - Form -->
        <div class="login-form-container">
            <h2>Login Pasien</h2>
            
            <%- include('partials/messages') %>

            <form id="loginForm" action="/login" method="POST" class="mt-4">
                <div class="form-floating mb-4">
                    <input type="email" class="form-control" id="email" name="email" placeholder="Email" required>
                    <label for="email">Email</label>
                </div>
                <div class="form-floating mb-4">
                    <input type="password" class="form-control" id="password" name="password" placeholder="Password" required>
                    <label for="password">Password</label>
                </div>
                <button type="submit" class="btn btn-primary w-100 btn-lg">Login</button>
            </form>
            <div class="text-center mt-4">
                <p>Belum punya akun? <a href="/register">Daftar di sini</a></p>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
