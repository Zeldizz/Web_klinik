<%- include('../partials/admin-layout-header') %>
<%- include('../partials/admin-sidebar') %>

<!-- Page Content -->
<div id="content">
    <%- include('../partials/admin-top-nav') %>

    <div class="main-content">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3>Kelola Jadwal Praktik</h3>
            <a href="/admin/jadwal/tambah" class="btn btn-success">
                <i class="fas fa-plus"></i> Tambah Jadwal
            </a>
        </div>
        <hr>

        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Nama Tenaga Medis</th>
                        <th>Hari</th>
                        <th>Jam Mulai</th>
                        <th>Jam Selesai</th>
                        <th>Status</th>
                        <th>Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (schedules && schedules.length > 0) { %>
                        <% schedules.forEach(schedule => { %>
                            <tr>
                                <td><%= schedule.nama_dokter %></td>
                                <td><%= schedule.hari %></td>
                                <td><%= schedule.jam_mulai %></td>
                                <td><%= schedule.jam_selesai %></td>
                                <td>
                                    <% if (schedule.status === 'Tersedia') { %>
                                        <span class="badge bg-success">Tersedia</span>
                                    <% } else { %>
                                        <span class="badge bg-danger">Tidak Tersedia</span>
                                    <% } %>
                                </td>
                                <td>
                                    <a href="/admin/jadwal/ubah/<%= schedule.id %>" class="btn btn-sm btn-warning">
                                        <i class="fas fa-edit"></i> Ubah
                                    </a>
                                    <form action="/admin/jadwal/hapus/<%= schedule.id %>" method="POST" class="d-inline" onsubmit="return confirm('Apakah Anda yakin ingin menghapus jadwal ini?');">
                                        <button type="submit" class="btn btn-sm btn-danger">
                                            <i class="fas fa-trash"></i> Hapus
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="6" class="text-center">Belum ada data jadwal.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('../partials/admin-layout-footer') %>
