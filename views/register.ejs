<%- include('partials/header') %>

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-header card-header-custom text-center">
                <h4>Registrasi Akun Pasien Baru</h4>
            </div>
            <div class="card-body p-4">
                <form id="registerForm" action="/register" method="POST">
                    <div class="mb-3">
                        <label for="nama" class="form-label">Nama Lengkap</label>
                        <input type="text" class="form-control" id="nama" name="nama" required>
                    </div>
                    <div class="mb-3">
                        <label for="email" class="form-label">Alamat Email</label>
                        <input type="email" class="form-control" id="email" name="email" required>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="no_ktp" class="form-label">No. KTP</label>
                            <input type="text" class="form-control" id="no_ktp" name="no_ktp" required pattern="[0-9]{16}" title="No. KTP harus terdiri dari 16 digit angka." inputmode="numeric">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="no_telepon" class="form-label">No. Telepon</label>
                            <input type="tel" class="form-control" id="no_telepon" name="no_telepon" required pattern="[0-9]{10,15}" title="No. Telepon harus terdiri dari 10-15 digit angka." inputmode="numeric">
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="jenis_kelamin" class="form-label">Jenis Kelamin</label>
                            <select class="form-select" id="jenis_kelamin" name="jenis_kelamin" required>
                                <option selected disabled value="">Pilih...</option>
                                <option value="Laki-laki">Laki-laki</option>
                                <option value="Perempuan">Perempuan</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="tanggal_lahir" class="form-label">Tanggal Lahir</label>
                            <input type="date" class="form-control" id="tanggal_lahir" name="tanggal_lahir" required>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="alamat" class="form-label">Alamat Lengkap</label>
                        <textarea class="form-control" id="alamat" name="alamat" rows="3" required></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label">Password</label>
                        <input type="password" class="form-control" id="password" name="password" required>
                    </div>

                    <div class="mb-3 p-3 bg-light rounded border">
                        <label for="captcha" class="form-label fw-bold">Verifikasi (Bukan Robot)</label>
                        <div id="captcha-container" class="mb-2">
                            <%- captchaImage %>
                        </div>
                        <input type="text" class="form-control" id="captcha" name="captcha" placeholder="Masukkan teks di atas" required>
                    </div>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">Daftar</button>
                    </div>
                </form>

                <!-- Notification Area -->
                <div id="notification-area" class="mt-3"></div>
                <div class="text-center mt-3">
                    <p>Sudah punya akun? <a href="/login">Login di sini</a></p>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Set max date for tanggal_lahir to yesterday
        const today = new Date();
        const yesterday = new Date(today);
        yesterday.setDate(today.getDate() - 1);

        const yyyy = yesterday.getFullYear();
        // Months are 0-based, pad with '0' if needed
        const mm = String(yesterday.getMonth() + 1).padStart(2, '0'); 
        const dd = String(yesterday.getDate()).padStart(2, '0');

        const maxDate = `${yyyy}-${mm}-${dd}`;
        document.getElementById('tanggal_lahir').setAttribute('max', maxDate);
    });

    const form = document.getElementById('registerForm');
    const notificationArea = document.getElementById('notification-area');
    const captchaContainer = document.getElementById('captcha-container');

    form.addEventListener('submit', async (e) => {
        e.preventDefault(); // Stop the page from reloading

        const formData = new FormData(form);
        notificationArea.innerHTML = ''; // Clear old messages

        // Disable button to prevent multiple submissions
        const submitButton = form.querySelector('button[type="submit"]');
        submitButton.disabled = true;
        submitButton.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Mendaftar...';

        try {
            const response = await fetch('/register', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: new URLSearchParams(formData).toString()
            });

            const result = await response.json();

            if (response.ok) {
                showNotification(result.message, 'success');
                form.reset();
                setTimeout(() => {
                    window.location.href = result.redirectUrl;
                }, 2000);
            } else {
                showNotification(result.message, 'danger');
                if (response.status === 400) { // CAPTCHA or other bad request
                    await refreshCaptcha();
                }
            }
        } catch (error) {
            console.error('Fetch error:', error);
            showNotification('Tidak dapat terhubung ke server.', 'danger');
        } finally {
            // Re-enable button
            submitButton.disabled = false;
            submitButton.innerHTML = 'Daftar';
        }
    });

    function showNotification(message, type) {
        const alert = `
            <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        `;
        notificationArea.innerHTML = alert;
    }

    async function refreshCaptcha() {
        try {
            const response = await fetch('/captcha');
            const newSvg = await response.text();
            captchaContainer.innerHTML = newSvg; // Replace the old SVG with the new one
        } catch (error) {
            console.error('Failed to refresh CAPTCHA:', error);
            captchaContainer.innerHTML = '<p class="text-danger">Gagal memuat CAPTCHA.</p>';
        }
    }
</script>

<%- include('partials/footer') %>
