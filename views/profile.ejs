<%- include('partials/header') %>

<div class="container section-padding-sm">
    <!-- Header Section -->
    <div class="row justify-content-center mb-5">
        <div class="col-md-10">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="display-6 fw-bold mb-2 text-primary">Profil Saya</h1>
                    <p class="text-muted mb-0">Kelola informasi pribadi dan lihat riwayat kunjungan Anda</p>
                </div>
                <div>
                    <a href="/dashboard" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>
                        Kembali ke Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Profile Content -->
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="row">
                <!-- Profile Information Card -->
                <div class="col-md-8 mb-4">
                    <div class="card card-modern">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center mb-4">
                                <div class="me-4">
                                    <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 rounded-circle" style="width: 80px; height: 80px;">
                                        <i class="fas fa-user text-primary" style="font-size: 2rem;"></i>
                                    </div>
                                </div>
                                <div>
                                    <h4 class="fw-bold mb-2 text-primary">Selamat Datang, <%= patientData.nama %>!</h4>
                                    <p class="text-muted mb-0">Informasi pribadi Anda</p>
                                </div>
                            </div>
                            
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold text-muted small">Email</label>
                                    <div class="fw-semibold"><%= patientData.email %></div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold text-muted small">No. KTP</label>
                                    <div class="fw-semibold"><%= patientData.no_ktp %></div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold text-muted small">No. Telepon</label>
                                    <div class="fw-semibold"><%= patientData.no_telepon %></div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold text-muted small">Tanggal Lahir</label>
                                    <div class="fw-semibold"><%= patientData.tgl_lahir_formatted %></div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold text-muted small">Jenis Kelamin</label>
                                    <div class="fw-semibold"><%= patientData.jenis_kelamin %></div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold text-muted small">Alamat</label>
                                    <div class="fw-semibold"><%= patientData.alamat %></div>
                                </div>
                            </div>
                            
                            <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                                <a href="/profile/edit" class="btn btn-primary">
                                    <i class="fas fa-edit me-2"></i>
                                    Ubah Profil
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Quick Actions Card -->
                <div class="col-md-4 mb-4">
                    <div class="card card-modern">
                        <div class="card-body p-4">
                            <h6 class="fw-bold mb-3">Aksi Cepat</h6>
                            <div class="d-grid gap-2">
                                <a href="/reservasi/baru" class="btn btn-outline-primary">
                                    <i class="fas fa-calendar-plus me-2"></i>
                                    Buat Reservasi
                                </a>
                                <a href="/reservasi/riwayat" class="btn btn-outline-info">
                                    <i class="fas fa-history me-2"></i>
                                    Riwayat Reservasi
                                </a>
                                <a href="/rekam-medis" class="btn btn-outline-success">
                                    <i class="fas fa-file-medical me-2"></i>
                                    Rekam Medis
                                </a>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Account Info Card -->
                    <div class="card card-modern mt-3">
                        <div class="card-body p-4">
                            <h6 class="fw-bold mb-3">Informasi Akun</h6>
                            <div class="mb-2">
                                <small class="text-muted">Status Akun:</small>
                                <div class="fw-semibold text-success">
                                    <i class="fas fa-check-circle me-1"></i>
                                    Aktif
                                </div>
                            </div>
                            <div class="mb-2">
                                <small class="text-muted">Bergabung Sejak:</small>
                                <div class="fw-semibold"><%= patientData.created_at ? new Date(patientData.created_at).toLocaleDateString('id-ID', { day: '2-digit', month: 'long', year: 'numeric' }) : 'Tidak tersedia' %></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent Visits Section -->
            <div class="row justify-content-center mt-4">
                <div class="col-md-10">
                    <div class="card card-modern">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <div>
                                    <h5 class="fw-bold mb-1">Riwayat Kunjungan Terbaru</h5>
                                    <p class="text-muted mb-0">Ringkasan kunjungan dan pemeriksaan Anda</p>
                                </div>
                                <a href="/rekam-medis" class="btn btn-outline-primary">
                                    <i class="fas fa-eye me-2"></i>
                                    Lihat Semua
                                </a>
                            </div>
                            
                            <% if (history.length > 0) { %>
                                <div class="row">
                                    <% history.slice(0, 3).forEach((h, index) => { %>
                                        <div class="col-md-4 mb-3">
                                            <div class="card bg-light h-100">
                                                <div class="card-body p-3">
                                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                                        <h6 class="fw-bold mb-1">Kunjungan <%= index + 1 %></h6>
                                                        <% 
                                                            let badgeClass = 'bg-secondary';
                                                            if (h.status === 'Selesai') badgeClass = 'bg-success';
                                                            else if (h.status === 'Menunggu') badgeClass = 'bg-warning';
                                                            else if (h.status === 'Dikonfirmasi') badgeClass = 'bg-info';
                                                        %>
                                                        <span class="badge <%= badgeClass %> rounded-pill small"><%= h.status %></span>
                                                    </div>
                                                    <div class="mb-2">
                                                        <small class="text-muted">Tanggal:</small>
                                                        <div class="fw-semibold small"><%= new Date(h.tanggal_reservasi).toLocaleDateString('id-ID', { day: '2-digit', month: 'long', year: 'numeric' }) %></div>
                                                    </div>
                                                    <div class="mb-2">
                                                        <small class="text-muted">Keluhan:</small>
                                                        <div class="fw-semibold small"><%= h.keluhan.length > 50 ? h.keluhan.substring(0, 50) + '...' : h.keluhan %></div>
                                                    </div>
                                                    <% if (h.status === 'Selesai' && h.rekam_medis_id) { %>
                                                        <a href="/rekam-medis/<%= h.rekam_medis_id %>" class="btn btn-outline-primary btn-sm w-100 mt-2">
                                                            <i class="fas fa-file-medical me-1"></i>
                                                            Lihat Rekam Medis
                                                        </a>
                                                    <% } %>
                                                </div>
                                            </div>
                                        </div>
                                    <% }) %>
                                </div>
                            <% } else { %>
                                <div class="text-center py-5">
                                    <div class="mb-3">
                                        <i class="fas fa-clipboard-list text-muted" style="font-size: 3rem;"></i>
                                    </div>
                                    <h6 class="text-muted">Belum Ada Riwayat Kunjungan</h6>
                                    <p class="text-muted mb-3">Anda belum memiliki riwayat kunjungan. Mulai jaga kesehatan Anda dengan membuat reservasi.</p>
                                    <a href="/reservasi/baru" class="btn btn-primary">
                                        <i class="fas fa-plus me-2"></i>
                                        Buat Reservasi Pertama
                                    </a>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
