<%- include('partials/header') %>

<div class="container mt-4">
    <h3 class="mb-4">Riwayat Pemeriksaan Anda</h3>

    <% if (riwayat && riwayat.length > 0) { %>
        <div class="accordion" id="riwayatAccordion">
            <% riwayat.forEach((item, index) => { %>
                <div class="accordion-item mb-3 border rounded">
                    <h2 class="accordion-header" id="heading<%= index %>">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse<%= index %>" aria-expanded="false" aria-controls="collapse<%= index %>">
                            <strong>Pemeriksaan Tanggal: <%= item.tanggal_pemeriksaan %></strong>
                        </button>
                    </h2>
                    <div id="collapse<%= index %>" class="accordion-collapse collapse" aria-labelledby="heading<%= index %>" data-bs-parent="#riwayatAccordion">
                        <div class="accordion-body">
                            <p><strong>Ditangani oleh:</strong> <%= item.nama_dokter %></p>
                            <hr>
                            <p><strong>Diagnosis:</strong><br><%= item.diagnosis %></p>
                            <p><strong>Pengobatan:</strong><br><%= item.pengobatan %></p>
                            <hr>
                            <a href="/rekam-medis/<%= item.id %>" class="btn btn-primary btn-sm">Lihat Rekam Medis</a>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <div class="alert alert-info" role="alert">
            Anda belum memiliki riwayat pemeriksaan yang telah selesai.
        </div>
    <% } %>
</div>

<%- include('partials/footer') %>
