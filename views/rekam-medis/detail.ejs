<%- include('../partials/header') %>

<div class="container section-padding-sm">
    <!-- Header Section -->
    <div class="row justify-content-center mb-5">
        <div class="col-md-10">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="display-6 fw-bold mb-2 text-primary">Detail Rekam Medis</h1>
                    <p class="text-muted mb-0">Informasi lengkap hasil pemeriksaan kesehatan</p>
                </div>
                <div>
                    <a href="/rekam-medis" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>
                        Kembali ke Daftar
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Medical Record Detail -->
    <div class="row justify-content-center">
        <div class="col-md-10">
            <% if (record) { %>
                <!-- Patient & Examination Info -->
                <div class="card card-modern mb-4">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center mb-4">
                            <div class="me-4">
                                <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 rounded-circle" style="width: 80px; height: 80px;">
                                    <i class="fas fa-file-medical-alt text-primary" style="font-size: 2rem;"></i>
                                </div>
                            </div>
                            <div class="flex-grow-1">
                                <h4 class="fw-bold mb-2">Pemeriksaan <%= record.tanggal_pemeriksaan_formatted %></h4>
                                <div class="row">
                                    <div class="col-md-6">

                                    </div>
                                    <div class="col-md-6">

                                    </div>
                                </div>
                            </div>
                            <div>
                                <span class="badge bg-success rounded-pill fs-6 px-3 py-2">
                                    <i class="fas fa-check-circle me-1"></i>
                                    Selesai
                                </span>
                            </div>
                        </div>
                        
                        <!-- Initial Complaint -->
                        <div class="alert alert-info border-start border-info border-3">
                            <h6 class="fw-bold mb-2">
                                <i class="fas fa-comment-medical me-2"></i>
                                Keluhan Awal
                            </h6>
                            <p class="mb-0"><%= record.keluhan %></p>
                        </div>
                        


                    </div>
                </div>

                <!-- Vital Signs -->
                <div class="card card-modern mb-4">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-4">
                            <i class="fas fa-heartbeat text-danger me-2"></i>
                            Tanda-Tanda Vital
                        </h5>
                        
                        <div class="row">
                            <div class="col-md-4 col-6 mb-3">
                                <div class="card bg-light h-100">
                                    <div class="card-body text-center p-3">
                                        <div class="mb-2">
                                            <i class="fas fa-heartbeat text-danger" style="font-size: 1.5rem;"></i>
                                        </div>
                                        <h6 class="fw-bold mb-1">Nadi</h6>
                                        <div class="fs-5 fw-bold text-primary"><%= record.nadi || '-' %></div>
                                        <small class="text-muted">/menit</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 col-6 mb-3">
                                <div class="card bg-light h-100">
                                    <div class="card-body text-center p-3">
                                        <div class="mb-2">
                                            <i class="fas fa-thermometer-half text-warning" style="font-size: 1.5rem;"></i>
                                        </div>
                                        <h6 class="fw-bold mb-1">Suhu</h6>
                                        <div class="fs-5 fw-bold text-primary"><%= record.suhu || '-' %></div>
                                        <small class="text-muted">°C</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 col-6 mb-3">
                                <div class="card bg-light h-100">
                                    <div class="card-body text-center p-3">
                                        <div class="mb-2">
                                            <i class="fas fa-lungs text-info" style="font-size: 1.5rem;"></i>
                                        </div>
                                        <h6 class="fw-bold mb-1">Pernafasan</h6>
                                        <div class="fs-5 fw-bold text-primary"><%= record.pernafasan || '-' %></div>
                                        <small class="text-muted">/menit</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 col-6 mb-3">
                                <div class="card bg-light h-100">
                                    <div class="card-body text-center p-3">
                                        <div class="mb-2">
                                            <i class="fas fa-tint text-danger" style="font-size: 1.5rem;"></i>
                                        </div>
                                        <h6 class="fw-bold mb-1">Tekanan Darah</h6>
                                        <div class="fs-5 fw-bold text-primary"><%= record.tekanan_darah || '-' %></div>
                                        <small class="text-muted">mmHg</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 col-6 mb-3">
                                <div class="card bg-light h-100">
                                    <div class="card-body text-center p-3">
                                        <div class="mb-2">
                                            <i class="fas fa-ruler-vertical text-success" style="font-size: 1.5rem;"></i>
                                        </div>
                                        <h6 class="fw-bold mb-1">Tinggi Badan</h6>
                                        <div class="fs-5 fw-bold text-primary"><%= record.tinggi_badan || '-' %></div>
                                        <small class="text-muted">cm</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 col-6 mb-3">
                                <div class="card bg-light h-100">
                                    <div class="card-body text-center p-3">
                                        <div class="mb-2">
                                            <i class="fas fa-weight text-primary" style="font-size: 1.5rem;"></i>
                                        </div>
                                        <h6 class="fw-bold mb-1">Berat Badan</h6>
                                        <div class="fs-5 fw-bold text-primary"><%= record.berat_badan || '-' %></div>
                                        <small class="text-muted">kg</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Examination Results -->
                <div class="card card-modern mb-4">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-4">
                            <i class="fas fa-stethoscope text-primary me-2"></i>
                            Hasil Pemeriksaan
                        </h5>
                        
                        <div class="row">
                            <!-- Diagnosis -->
                            <div class="col-md-6 mb-4">
                                <div class="border-start border-primary border-3 ps-3">
                                    <h6 class="fw-bold text-primary mb-2">
                                        <i class="fas fa-diagnoses me-2"></i>
                                        Diagnosis
                                    </h6>
                                    <div class="bg-light p-3 rounded">
                                        <%= record.diagnosis %>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Treatment -->
                            <div class="col-md-6 mb-4">
                                <div class="border-start border-success border-3 ps-3">
                                    <h6 class="fw-bold text-success mb-2">
                                        <i class="fas fa-procedures me-2"></i>
                                        Tindakan
                                    </h6>
                                    <div class="bg-light p-3 rounded">
                                        <%= record.tindakan %>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Prescription -->
                            <div class="col-12 mb-4">
                                <div class="border-start border-warning border-3 ps-3">
                                    <h6 class="fw-bold text-warning mb-2">
                                        <i class="fas fa-pills me-2"></i>
                                        Resep Obat
                                    </h6>
                                    <div class="section-content">
                                        <% if (record.resep_obat && record.resep_obat.trim() !== '') { %>
                                            <div class="resep-container-pasien mt-2">
                                                <% 
                                                const resepList = record.resep_obat.split(';').map(item => item.trim()).filter(item => item);
                                                resepList.forEach((resep, index) => {
                                                    const parts = resep.split('-').map(part => part.trim());
                                                    const namaObat = parts[0] || 'Tidak ada nama obat';
                                                    const aturanMinum = parts[1] || 'Tidak ada aturan';
                                                    const waktuKonsumsi = parts[2] || 'Tidak ada waktu';
                                                %>
                                                    <div class="resep-item-pasien p-3 rounded mb-2 bg-light">
                                                        <p class="fw-bold mb-1 text-dark"><%= namaObat %></p>
                                                        <p class="mb-0 text-muted"><small><strong>Aturan:</strong> <%= aturanMinum %></small></p>
                                                        <p class="mb-0 text-muted"><small><strong>Waktu:</strong> <%= waktuKonsumsi %></small></p>
                                                    </div>
                                                <% }); %>
                                            </div>
                                        <% } else { %>
                                            <div class="bg-light p-3 rounded">
                                                <p class="text-muted mb-0">Tidak ada resep obat.</p>
                                            </div>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Additional Notes -->
                            <% if (record.catatan_tambahan) { %>
                                <div class="col-12">
                                    <div class="border-start border-info border-3 ps-3">
                                        <h6 class="fw-bold text-info mb-2">
                                            <i class="fas fa-sticky-note me-2"></i>
                                            Catatan Tambahan
                                        </h6>
                                        <div class="bg-light p-3 rounded">
                                            <%= record.catatan_tambahan %>
                                        </div>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
                
                <!-- Action Buttons -->
                <div class="card card-modern">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="fw-bold mb-1">Aksi Dokumen</h6>
                                <small class="text-muted">Cetak atau unduh rekam medis untuk keperluan Anda</small>
                            </div>
                            <div>
                                <a href="javascript:history.back()" class="btn btn-outline-secondary me-2">
                                    <i class="fas fa-arrow-left me-2"></i>
                                    Kembali
                                </a>
                                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#printPreviewModal" data-record-id="<%= record.id %>">
                                    <i class="fas fa-print me-2"></i>
                                    Cetak Rekam Medis
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

            <% } else { %>
                <div class="card card-modern">
                    <div class="card-body text-center py-5">
                        <div class="mb-4">
                            <i class="fas fa-exclamation-triangle text-warning" style="font-size: 4rem;"></i>
                        </div>
                        <h4 class="fw-bold mb-3">Rekam Medis Tidak Ditemukan</h4>
                        <p class="text-muted mb-4">Detail rekam medis yang Anda cari tidak dapat ditemukan atau mungkin telah dihapus.</p>
                        <a href="/rekam-medis" class="btn btn-primary">
                            <i class="fas fa-arrow-left me-2"></i>
                            Kembali ke Daftar Rekam Medis
                        </a>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</div>

<!-- Modal for Print Preview -->
<div class="modal fade" id="printPreviewModal" tabindex="-1" aria-labelledby="printPreviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="printPreviewModalLabel">Pratinjau Cetak Rekam Medis</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <iframe id="previewFrame" src="about:blank" style="width: 100%; height: 60vh; border: none;"></iframe>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Tutup</button>
                <button type="button" class="btn btn-info" onclick="printPreview()">Cetak</button>
                <a id="downloadPdfButton" href="#" class="btn btn-primary" download>Unduh PDF</a>
            </div>
        </div>
    </div>
</div>

<script>
    const printPreviewModal = document.getElementById('printPreviewModal');
    const previewFrame = document.getElementById('previewFrame');
    const downloadPdfButton = document.getElementById('downloadPdfButton');

    printPreviewModal.addEventListener('show.bs.modal', function (event) {
        const button = event.relatedTarget;
        const recordId = button.getAttribute('data-record-id');
        
        // Set the source for the iframe and the download button
        const previewUrl = `/rekam-medis/${recordId}/preview`;
        const downloadUrl = `/rekam-medis/${recordId}/cetak`;

        previewFrame.src = previewUrl;
        downloadPdfButton.href = downloadUrl;
    });

    function printPreview() {
        try {
            previewFrame.contentWindow.focus();
            previewFrame.contentWindow.print();
        } catch (e) {
            console.error('Gagal mencetak pratinjau:', e);
            alert('Browser Anda mungkin memblokir fungsi cetak dari iframe. Coba unduh PDF dan cetak dari sana.');
        }
    }
</script>

<%- include('../partials/footer') %>