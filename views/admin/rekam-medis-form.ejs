    const obatOptions = [
        // Obat Demam & Nyeri
        'Paracetamol 500mg', 'Paracetamol Sirup 120mg/5ml', 'Ibuprofen 400mg', 'Ibuprofen Sirup 100mg/5ml',
        'Aspirin 500mg', 'Metamizole 500mg', 'Diclofenac 50mg', 'Diclofenac Gel 1%',
        
        // Antibiotik
        'Amoxicillin 500mg', 'Amoxicillin Sirup 125mg/5ml', 'Ampicillin 500mg', 'Ciprofloxacin 500mg',
        'Azithromycin 500mg', 'Cefixime 200mg', 'Cefadroxil 500mg', 'Erythromycin 500mg',
        'Cloxacillin 500mg', 'Cotrimoxazole 480mg', 'Doxycycline 100mg',
        
        // Obat Alergi & Antihistamin
        'Cetirizine 10mg', 'Cetirizine Sirup 5mg/5ml', 'Loratadine 10mg', 'Chlorpheniramine 4mg',
        'Diphenhydramine 25mg', 'Fexofenadine 120mg', 'Desloratadine 5mg',
        
        // Obat Pencernaan
        'Omeprazole 20mg', 'Ranitidine 150mg', 'Antasida Tablet', 'Antasida Sirup',
        'Domperidone 10mg', 'Metoclopramide 10mg', 'Loperamide 2mg', 'Bismuth Subsalicylate',
        'Lansoprazole 30mg', 'Sucralfate 500mg', 'Simethicone 40mg', 'ORS (Oralit)',
        
        // Obat Batuk & Pilek
        'Dextromethorphan 15mg', 'Guaifenesin 200mg', 'Bromhexine 8mg', 'Ambroxol 30mg',
        'Salbutamol 2mg', 'Salbutamol Sirup 2mg/5ml', 'Theophylline 200mg',
        
        // Obat Gigi & Mulut
        'Asam Mefenamat 500mg', 'Benzocaine Gel', 'Povidone Iodine Gargle', 'Chlorhexidine Mouthwash',
        
        // Salep & Obat Luar
        'Betamethasone Cream 0.1%', 'Hydrocortisone Cream 1%', 'Ketoconazole Cream 2%',
        'Miconazole Cream 2%', 'Gentamicin Cream 0.1%', 'Acyclovir Cream 5%',
        'Calamine Lotion', 'Povidone Iodine Solution 10%', 'Silver Sulfadiazine Cream 1%',
        'Clotrimazole Cream 1%', 'Neomycin Sulfate Ointment', 'Zinc Oxide Ointment',
        
        // Obat Mata & Telinga
        'Chloramphenicol Eye Drops 0.5%', 'Ofloxacin Eye Drops 0.3%', 'Artificial Tears',
        'Ofloxacin Ear Drops 0.3%', 'Waxsol Ear Drops',
        
        // Obat Kardiovaskular
        'Amlodipine 5mg', 'Captopril 25mg', 'Atenolol 50mg', 'Furosemide 40mg',
        'Simvastatin 20mg', 'Atorvastatin 20mg', 'Bisoprolol 5mg',
        
        // Obat Diabetes
        'Metformin 500mg', 'Glibenclamide 5mg', 'Glimepiride 2mg', 'Acarbose 50mg',
        
        // Vitamin & Suplemen
        'Vitamin B Complex', 'Vitamin C 500mg', 'Vitamin D3 1000 IU', 'Vitamin E 400 IU',
        'Folic Acid 5mg', 'Iron Sulfate 200mg', 'Calcium Carbonate 500mg', 'Zinc Sulfate 20mg',
        'Multivitamin Tablet', 'Cod Liver Oil Capsule',
        
        // Obat Lain-lain
        'Dexamethasone 0.5mg', 'Prednisolone 5mg', 'Methylprednisolone 4mg',
        'Allopurinol 100mg', 'Colchicine 0.5mg', 'Phenytoin 100mg'
    ].sort(); // Mengurutkan secara alfabetis
    
    const aturanMinumOptions = [
        // Tablet
        '1 x 1 tablet per hari', '2 x 1 tablet per hari', '3 x 1 tablet per hari',
        '1 x 2 tablet per hari', '2 x 2 tablet per hari', '3 x 2 tablet per hari',
        '4 x 1 tablet per hari', '1 x 1/2 tablet per hari', '2 x 1/2 tablet per hari',
        
        // Kapsul
        '1 x 1 kapsul per hari', '2 x 1 kapsul per hari', '3 x 1 kapsul per hari',
        '1 x 2 kapsul per hari', '2 x 2 kapsul per hari', '3 x 2 kapsul per hari',
        '4 x 1 kapsul per hari',
        
        // Sirup/Cairan
        '1 x 1 sendok teh per hari', '2 x 1 sendok teh per hari', '3 x 1 sendok teh per hari',
        '1 x 2 sendok teh per hari', '2 x 2 sendok teh per hari', '3 x 2 sendok teh per hari',
        '1 x 1 sendok makan per hari', '2 x 1 sendok makan per hari', '3 x 1 sendok makan per hari',
        '1 x 2 sendok makan per hari', '2 x 2 sendok makan per hari', '3 x 2 sendok makan per hari',
        '1 x 5ml per hari', '2 x 5ml per hari', '3 x 5ml per hari',
        '1 x 10ml per hari', '2 x 10ml per hari', '3 x 10ml per hari',
        
