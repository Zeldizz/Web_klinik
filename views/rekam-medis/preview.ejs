<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Pratinjau Rekam Medis - <%= record.nama_pasien %></title>
    <style>
        body {
            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
            font-size: 12px;
            line-height: 1.6;
            color: #333;
            margin: 0;
            padding: 0;
            background-color: #fff;
        }
        .container {
            width: 100%;
            max-width: 800px; /* A4-like width */
            margin: 0 auto;
            padding: 20px;
        }
        .header {
            text-align: center;
            border-bottom: 2px solid #000;
            padding-bottom: 10px;
            margin-bottom: 20px;
        }
        .header img {
            width: 50px; /* Adjusted logo size */
            margin-bottom: 10px;
        }
        .header h3 {
            margin: 0;
            font-size: 16px;
        }
        .header p {
            margin: 0;
            font-size: 12px;
        }
        .title {
            text-align: center;
            font-weight: bold;
            font-size: 14px;
            margin-bottom: 30px;
            text-decoration: underline;
        }
        .content-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }
        .content-table td {
            padding: 5px 0;
            vertical-align: top;
        }
        .label {
            width: 150px;
        }
        .separator {
            width: 15px;
            text-align: center;
        }
        .section-title {
            font-weight: bold;
            font-size: 13px;
            margin-top: 20px;
            margin-bottom: 10px;
        }
        .resep-list {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 0 20px; /* Spasi antar kolom */
            padding: 0;
            margin: 0;
        }
        .resep-item {
            margin-bottom: 10px;
        }
        .resep-item:last-child {
            margin-bottom: 0;
        }
        .resep-item p {
            margin: 0;
        }
        .resep-item .nama-obat {
            font-weight: bold;
        }
        .resep-item .detail-resep {
            padding-left: 15px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">

            <h3>Klinik AL-Furqon</h3>
            <p>Griya Bintang Sejahtera Blok C No.01 Rt.08 Rw.11 Kel. Sako Kec. Sako Palembang</p>
            <p>Tlp: 0877 9095 7676</p>
        </div>

        <div class="title">LAPORAN DATA REKAM MEDIS PASIEN</div>

        <table class="content-table">
            <tr>
                <td class="label">Tanggal Reservasi</td>
                <td class="separator">:</td>
                <td><%= record.tanggal_reservasi_formatted || '-' %></td>
                <td class="label">NIK</td>
                <td class="separator">:</td>
                <td><%= record.nik || '-' %></td>
            </tr>
            <tr>
                <td class="label">Id Reservasi</td>
                <td class="separator">:</td>
                <td><%= record.reservasi_id || '-' %></td>
                <td class="label">Nama Pasien</td>
                <td class="separator">:</td>
                <td><%= record.nama_pasien || '-' %></td>
            </tr>
            <tr>
                <td class="label">Dokter</td>
                <td class="separator">:</td>
                <td><%= record.nama_dokter || '-' %></td>
                <td class="label">Jenis Kelamin</td>
                <td class="separator">:</td>
                <td><%= record.jenis_kelamin || '-' %></td>
            </tr>
            <tr>
                <td class="label">Tanggal Pemeriksaan</td>
                <td class="separator">:</td>
                <td><%= record.tanggal_pemeriksaan_formatted || '-' %></td>
                <td class="label">Tanggal Lahir</td>
                <td class="separator">:</td>
                <td><%= record.tanggal_lahir_formatted || '-' %></td>
            </tr>
        </table>

        <div class="section-title">Pemeriksaan Utama</div>
        <table class="content-table">
            <tr>
                <td class="label">Keluhan</td>
                <td class="separator">:</td>
                <td><%= record.keluhan || '-' %></td>
            </tr>
            <tr>
                <td class="label" colspan="3">Keadaan Umum</td>
            </tr>
            <tr>
                <td style="padding-left: 20px;">Nadi</td>
                <td class="separator">:</td>
                <td><%= record.nadi ? record.nadi + ' x/menit' : '-' %></td>
            </tr>
            <tr>
                <td style="padding-left: 20px;">Suhu</td>
                <td class="separator">:</td>
                <td><%= record.suhu ? record.suhu + ' °C' : '-' %></td>
            </tr>
            <tr>
                <td style="padding-left: 20px;">Pernafasan</td>
                <td class="separator">:</td>
                <td><%= record.pernafasan ? record.pernafasan + ' x/menit' : '-' %></td>
            </tr>
            <tr>
                <td style="padding-left: 20px;">Tek. Darah</td>
                <td class="separator">:</td>
                <td><%= record.tekanan_darah ? record.tekanan_darah + ' mmHg' : '-' %></td>
            </tr>
            <tr>
                <td style="padding-left: 20px;">Tinggi Badan</td>
                <td class="separator">:</td>
                <td><%= record.tinggi_badan ? record.tinggi_badan + ' cm' : '-' %></td>
            </tr>
            <tr>
                <td style="padding-left: 20px;">Berat Badan</td>
                <td class="separator">:</td>
                <td><%= record.berat_badan ? record.berat_badan + ' kg' : '-' %></td>
            </tr>
            <tr>
                <td class="label">Diagnosa</td>
                <td class="separator">:</td>
                <td><%= record.diagnosis || '-' %></td>
            </tr>
            <tr>
                <td class="label">Tindakan</td>
                <td class="separator">:</td>
                <td><%= record.tindakan || '-' %></td>
            </tr>
            <tr>
                <td class="label" style="vertical-align: top;">Resep Obat</td>
                <td class="separator" style="vertical-align: top;">:</td>
                <td>
                    <% if (record.resep_obat && record.resep_obat.trim() !== '') { %>
                        <div class="resep-list">
                            <% 
                            const resepList = record.resep_obat.split(';').map(item => item.trim()).filter(item => item);
                            resepList.forEach(resep => {
                                const parts = resep.split('-').map(part => part.trim());
                                const namaObat = parts[0] || 'N/A';
                                const aturanMinum = parts[1] || 'N/A';
                                const waktuKonsumsi = parts[2] || 'N/A';
                            %>
                                <div class="resep-item">
                                    <p class="nama-obat"><%= namaObat %></p>
                                    <div class="detail-resep">
                                        <p>Aturan: <%= aturanMinum %></p>
                                        <p>Waktu: <%= waktuKonsumsi %></p>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    <% } else { %>
                        -
                    <% } %>
                </td>
            </tr>
            <tr>
                <td class="label">Catatan Tambahan</td>
                <td class="separator">:</td>
                <td><%= record.catatan || '-' %></td>
            </tr>
        </table>
    </div>
</body>
</html>
