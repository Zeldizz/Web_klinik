<%- include('../partials/admin-layout-header') %>
<%- include('../partials/admin-sidebar') %>

<!-- Page Content -->
<div id="content">
    <%- include('../partials/admin-top-nav') %>

    <div class="main-content">
        <h3><%= title %></h3>
        <hr>

        <form action="/admin/tenaga-medis/<%= action %>" method="POST">
            <div class="mb-3">
                <label for="nama_lengkap" class="form-label">Nama Lengkap</label>
                <input type="text" class="form-control" id="nama_lengkap" name="nama_lengkap" value="<%= staff.nama_lengkap || '' %>" required>
            </div>
            <div class="mb-3">
                <label for="username" class="form-label">Username</label>
                <input type="text" class="form-control" id="username" name="username" value="<%= staff.username || '' %>" required>
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input type="password" class="form-control" id="password" name="password" <%= action === 'tambah' ? 'required' : '' %>>
                <% if (action.startsWith('ubah')) { %>
                    <div class="form-text">Kosongkan jika tidak ingin mengubah password.</div>
                <% } %>
            </div>
            <div class="mb-3">
                <label for="role" class="form-label">Role</label>
                <select class="form-select" id="role" name="role" required>
                    <option value="Admin" <%= staff.role === 'Admin' ? 'selected' : '' %>>Admin</option>
                    <option value="Tenaga Medis" <%= staff.role === 'Tenaga Medis' ? 'selected' : '' %>>Tenaga Medis</option>
                    <option value="Pimpinan Klinik" <%= staff.role === 'Pimpinan Klinik' ? 'selected' : '' %>>Pimpinan Klinik</option>
                </select>
            </div>

            <div class="mb-3" id="spesialis-field-container" style="display: none;">
                <label for="spesialis" class="form-label">Spesialis</label>
                <input type="text" class="form-control" id="spesialis" name="spesialis" value="<%= staff.spesialis || '' %>">
                <div class="form-text">Contoh: Dokter Umum, Dokter Gigi, Bidan.</div>
            </div>
            
            <button type="submit" class="btn btn-primary">Simpan</button>
            <a href="/admin/tenaga-medis" class="btn btn-secondary">Batal</a>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const roleSelect = document.getElementById('role');
        const spesialisContainer = document.getElementById('spesialis-field-container');

        function toggleSpesialisField() {
            if (roleSelect.value === 'Tenaga Medis') {
                spesialisContainer.style.display = 'block';
            } else {
                spesialisContainer.style.display = 'none';
            }
        }

        // Initial check on page load
        toggleSpesialisField();

        // Add event listener for changes
        roleSelect.addEventListener('change', toggleSpesialisField);
    });
</script>

<%- include('../partials/admin-layout-footer') %>
