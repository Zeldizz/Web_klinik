<%- include('../partials/header') %>

<div class="container section-padding-sm">
    <!-- Header Section -->
    <div class="row justify-content-center mb-5">
        <div class="col-md-10">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="display-6 fw-bold mb-2 text-primary">Rekam Medis</h1>
                    <p class="text-muted mb-0">Riwayat pemeriksaan dan diagnosis kesehatan Anda</p>
                </div>
                <div>
                    <a href="/dashboard" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>
                        Kembali ke Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Medical Records Content -->
    <div class="row justify-content-center">
        <div class="col-md-10">
            <% if (records.length > 0) { %>
                <!-- Records Stats -->
                <div class="row mb-4">
                    <div class="col-md-4">
                        <div class="card card-modern text-center">
                            <div class="card-body p-3">
                                <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 rounded-circle mb-2" style="width: 50px; height: 50px;">
                                    <i class="fas fa-file-medical text-primary"></i>
                                </div>
                                <h5 class="fw-bold mb-1"><%= records.length %></h5>
                                <small class="text-muted">Total Rekam Medis</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card card-modern text-center">
                            <div class="card-body p-3">
                                <div class="d-inline-flex align-items-center justify-content-center bg-success bg-opacity-10 rounded-circle mb-2" style="width: 50px; height: 50px;">
                                    <i class="fas fa-user-md text-success"></i>
                                </div>
                                <h5 class="fw-bold mb-1"><%= [...new Set(records.map(r => r.nama_dokter))].length %></h5>
                                <small class="text-muted">Dokter yang Menangani</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card card-modern text-center">
                            <div class="card-body p-3">
                                <div class="d-inline-flex align-items-center justify-content-center bg-info bg-opacity-10 rounded-circle mb-2" style="width: 50px; height: 50px;">
                                    <i class="fas fa-calendar-check text-info"></i>
                                </div>
                                <h5 class="fw-bold mb-1"><%= records[0].tanggal_pemeriksaan.split(',')[0] %></h5>
                                <small class="text-muted">Kunjungan Terakhir</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Medical Records List -->
                <div class="card card-modern">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h5 class="fw-bold mb-0">Riwayat Pemeriksaan</h5>
                            <small class="text-muted">Klik untuk melihat detail</small>
                        </div>
                        
                        <div class="accordion accordion-flush" id="rekamMedisAccordion">
                            <% records.forEach((record, index) => { %>
                                <div class="accordion-item border rounded mb-3">
                                    <h2 class="accordion-header" id="heading<%= index %>">
                                        <button class="accordion-button collapsed fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#collapse<%= index %>" aria-expanded="false" aria-controls="collapse<%= index %>">
                                            <div class="d-flex align-items-center w-100">
                                                <div class="me-3">
                                                    <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 rounded-circle" style="width: 40px; height: 40px;">
                                                        <i class="fas fa-stethoscope text-primary"></i>
                                                    </div>
                                                </div>
                                                <div class="flex-grow-1">
                                                    <div class="fw-bold">Pemeriksaan <%= record.tanggal_pemeriksaan %></div>
                                                    <small class="text-muted">Ditangani oleh Dr. <%= record.nama_dokter %></small>
                                                </div>
                                                <div class="text-end">
                                                    <span class="badge bg-success rounded-pill">Selesai</span>
                                                </div>
                                            </div>
                                        </button>
                                    </h2>
                                    <div id="collapse<%= index %>" class="accordion-collapse collapse" aria-labelledby="heading<%= index %>" data-bs-parent="#rekamMedisAccordion">
                                        <div class="accordion-body bg-light">
                                            <div class="row">
                                                <div class="col-md-6 mb-3">
                                                    <h6 class="fw-bold text-primary mb-2">
                                                        <i class="fas fa-diagnoses me-2"></i>
                                                        Diagnosis
                                                    </h6>
                                                    <div class="p-3 bg-white rounded border-start border-primary border-3">
                                                        <%= record.diagnosis %>
                                                    </div>
                                                </div>
                                                <div class="col-md-6 mb-3">
                                                    <h6 class="fw-bold text-success mb-2">
                                                        <i class="fas fa-pills me-2"></i>
                                                        Pengobatan
                                                    </h6>
                                                    <div class="p-3 bg-white rounded border-start border-success border-3">
                                                        <%= record.pengobatan %>
                                                    </div>
                                                </div>
                                            </div>
                                            
                                            <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                                                <div>
                                                    <small class="text-muted">
                                                        <i class="fas fa-clock me-1"></i>
                                                        Diperiksa pada <%= record.tanggal_pemeriksaan %>
                                                    </small>
                                                </div>
                                                <div>
                                                    <a href="/rekam-medis/<%= record.id %>" class="btn btn-primary">
                                                        <i class="fas fa-eye me-2"></i>
                                                        Lihat Detail
                                                    </a>
                                                    <a href="/rekam-medis/<%= record.id %>/preview" class="btn btn-outline-info ms-2" target="_blank">
                                                        <i class="fas fa-print me-2"></i>
                                                        Cetak
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                </div>
            <% } else { %>
                <div class="card card-modern">
                    <div class="card-body text-center py-5">
                        <div class="mb-4">
                            <i class="fas fa-file-medical text-muted" style="font-size: 4rem;"></i>
                        </div>
                        <h4 class="fw-bold mb-3">Belum Ada Rekam Medis</h4>
                        <p class="text-muted mb-4">Anda belum memiliki riwayat rekam medis yang tercatat di sistem kami.<br>Mulai jaga kesehatan Anda dengan membuat reservasi pemeriksaan.</p>
                        <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                            <a href="/reservasi/baru" class="btn btn-primary btn-lg">
                                <i class="fas fa-plus me-2"></i>
                                Buat Reservasi Baru
                            </a>
                            <a href="/dashboard" class="btn btn-outline-secondary btn-lg">
                                <i class="fas fa-home me-2"></i>
                                Kembali ke Dashboard
                            </a>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
