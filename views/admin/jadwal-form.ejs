<%- include('../partials/admin-layout-header') %>
<%- include('../partials/admin-sidebar') %>

<!-- Page Content -->
<div id="content">
    <%- include('../partials/admin-top-nav') %>

    <div class="main-content">
        <h3><%= title %></h3>
        <hr>

        <form action="/admin/jadwal/<%= action %>" method="POST">
            <div class="mb-3">
                <label for="id_admin" class="form-label">Tenaga Medis</label>
                <select class="form-select" id="id_admin" name="id_admin" required>
                    <option value="">-- Pilih Tenaga Medis --</option>
                    <% doctors.forEach(doctor => { %>
                        <option value="<%= doctor.id %>" <%= (schedule.id_admin == doctor.id) ? 'selected' : '' %> >
                            <%= doctor.nama_lengkap %>
                        </option>
                    <% }) %>
                </select>
            </div>

            <div class="mb-3">
                <label for="hari" class="form-label">Hari Praktik</label>
                <div class="d-flex flex-wrap gap-3">
                    <% const days = ['Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu', 'Minggu']; %>
                    <% days.forEach(day => { %>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="hari" id="hari_<%= day %>" value="<%= day %>"
                                <%= (schedule.days && schedule.days.includes(day)) ? 'checked' : '' %>>
                            <label class="form-check-label" for="hari_<%= day %>"><%= day %></label>
                        </div>
                    <% }) %>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="jam_mulai" class="form-label">Jam Mulai</label>
                    <input type="time" class="form-control" id="jam_mulai" name="jam_mulai" value="<%= schedule.jam_mulai || '' %>" required>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="jam_selesai" class="form-label">Jam Selesai</label>
                    <input type="time" class="form-control" id="jam_selesai" name="jam_selesai" value="<%= schedule.jam_selesai || '' %>" required>
                </div>
            </div>

            <div class="mb-3">
                <label for="status" class="form-label">Status</label>
                <select class="form-select" id="status" name="status" required>
                    <option value="Aktif" <%= (schedule.status === 'Aktif' || schedule.status === 'Tersedia') ? 'selected' : '' %>>Aktif</option>
                    <option value="Tidak Aktif" <%= (schedule.status === 'Tidak Aktif' || schedule.status === 'Tidak Tersedia') ? 'selected' : '' %>>Tidak Aktif</option>
                </select>
            </div>
            
            <button type="submit" class="btn btn-primary">Simpan</button>
            <a href="/admin/jadwal" class="btn btn-secondary">Batal</a>
        </form>
    </div>
</div>

<%- include('../partials/admin-layout-footer') %>
