            <div class="row align-items-end">
                <div class="col-md-3 mb-2">
                    <label class="form-label"><strong>Nama Obat</strong> <span class="text-danger">*</span></label>
                    <select class="form-select obat-select" name="obat_nama[]" required>
                        ${obatOptionsHTML}
                    </select>
                </div>
                <div class="col-md-3 mb-2">
                    <label class="form-label"><strong>Aturan Minum</strong> <span class="text-danger">*</span></label>
                    <select class="form-select aturan-minum-select" name="obat_aturan_minum[]" required>
                        ${aturanMinumOptionsHTML}
                    </select>
                </div>
                <div class="col-md-4 mb-2">
                    <label class="form-label"><strong>Waktu Konsumsi</strong> <span class="text-danger">*</span></label>
                    <select class="form-select waktu-konsumsi-select" name="obat_waktu_konsumsi[]" required>
                        ${waktuKonsumsiOptionsHTML}
                    </select>
                </div>
                <div class="col-md-2 mb-2">
                    <button type="button" class="btn btn-danger btn-sm remove-obat">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
            </div>
        </div>
    `;
}

// Fungsi untuk update hidden field resep_obat
function updateResepObatField() {
    const obatItems = document.querySelectorAll('.obat-item');
    const resepData = [];
    
    obatItems.forEach(item => {
        const namaObat = item.querySelector('.obat-select').value;
        const aturanMinum = item.querySelector('.aturan-minum-select').value;
        const waktuKonsumsi = item.querySelector('.waktu-konsumsi-select').value;
        
        if (namaObat && aturanMinum && waktuKonsumsi) {
            resepData.push(`${namaObat} - ${aturanMinum} - ${waktuKonsumsi}`);
        }
    });
    
    document.getElementById('resep_obat').value = resepData.join('; ');
}

// Fungsi untuk toggle tombol hapus
function toggleRemoveButtons() {
    const obatItems = document.querySelectorAll('.obat-item');
    const removeButtons = document.querySelectorAll('.remove-obat');
    
    removeButtons.forEach(button => {
        button.style.display = obatItems.length > 1 ? 'block' : 'none';
    });
}

// Fungsi untuk menginisialisasi form dengan data yang ada
function initializeObatForm() {
    const container = document.getElementById('obat-container');
    const existingResepObat = document.getElementById('resep_obat').value;
    
    // Cek apakah ada data obat dari server (form submission error)
    const serverObatNama = '<%= JSON.stringify(rekamMedis.obat_nama || []) %>';
    const serverObatAturanMinum = '<%= JSON.stringify(rekamMedis.obat_aturan_minum || []) %>';
    const serverObatWaktuKonsumsi = '<%= JSON.stringify(rekamMedis.obat_waktu_konsumsi || []) %>';
    
    let obatNamaArray, obatAturanMinumArray, obatWaktuKonsumsiArray;
    try {
        obatNamaArray = JSON.parse(serverObatNama);
        obatAturanMinumArray = JSON.parse(serverObatAturanMinum);
        obatWaktuKonsumsiArray = JSON.parse(serverObatWaktuKonsumsi);
    } catch (e) {
        obatNamaArray = [];
        obatAturanMinumArray = [];
        obatWaktuKonsumsiArray = [];
    }
    
    // Jika ada data dari form submission sebelumnya (error case)
    if (obatNamaArray.length > 0 && obatAturanMinumArray.length > 0 && obatWaktuKonsumsiArray.length > 0) {
        for (let i = 0; i < obatNamaArray.length; i++) {
            const namaValue = obatNamaArray[i] || '';
            const aturanMinumValue = obatAturanMinumArray[i] || '';
            const waktuKonsumsiValue = obatWaktuKonsumsiArray[i] || '';
            
            const newObatHTML = createObatTemplate(i, namaValue, aturanMinumValue, waktuKonsumsiValue);
            container.insertAdjacentHTML('beforeend', newObatHTML);
        }
    }
    // Jika ada data dari existing record (edit case)
    else if (existingResepObat && existingResepObat.trim() !== '') {
        const resepItems = existingResepObat.split(';');
        resepItems.forEach((item, index) => {
            const parts = item.trim().split(' - ');
            if (parts.length === 3) {
                // Format baru: "Nama Obat - Aturan Minum - Waktu Konsumsi"
                const namaObat = parts[0].trim();
                const aturanMinum = parts[1].trim();
                const waktuKonsumsi = parts[2].trim();
                const newObatHTML = createObatTemplate(index, namaObat, aturanMinum, waktuKonsumsi);
                container.insertAdjacentHTML('beforeend', newObatHTML);
            } else if (parts.length === 2) {
                // Format lama: "Nama Obat - Aturan Konsumsi" (untuk backward compatibility)
                const namaObat = parts[0].trim();
                const aturanLama = parts[1].trim();
                // Coba pisahkan aturan lama jika memungkinkan
                const newObatHTML = createObatTemplate(index, namaObat, aturanLama, '');
                container.insertAdjacentHTML('beforeend', newObatHTML);
            }
        });
    }
    // Jika tidak ada data, buat template kosong pertama
    else {
        const newObatHTML = createObatTemplate(0);
        container.insertAdjacentHTML('beforeend', newObatHTML);
    }
    
    // Initialize search hanya untuk dropdown obat (tidak untuk aturan minum dan waktu konsumsi)
    container.querySelectorAll('.obat-select').forEach(select => {
        addSearchToSelect(select);
    });
    
    toggleRemoveButtons();
}

// Event listener untuk DOM ready
document.addEventListener('DOMContentLoaded', function() {
    let obatCounter = 1;
    
    // Initialize form dengan data yang ada
    initializeObatForm();
    
    // Event listener untuk tombol tambah obat
    document.getElementById('tambah-obat').addEventListener('click', function() {
        const container = document.getElementById('obat-container');
        const newObatHTML = createObatTemplate(obatCounter);
        
        container.insertAdjacentHTML('beforeend', newObatHTML);
        
        // Initialize search hanya untuk dropdown obat baru (tidak untuk aturan minum dan waktu konsumsi)
        const newItem = container.lastElementChild;
        newItem.querySelectorAll('.obat-select').forEach(select => {
            addSearchToSelect(select);
        });
        
        obatCounter++;
        toggleRemoveButtons();
    });
    
    // Event listener untuk tombol hapus obat (menggunakan event delegation)
    document.getElementById('obat-container').addEventListener('click', function(e) {
        if (e.target.closest('.remove-obat')) {
            e.target.closest('.obat-item').remove();
            toggleRemoveButtons();
            updateResepObatField();
        }
    });
    
    // Event listener untuk perubahan dropdown (update hidden field)
    document.getElementById('obat-container').addEventListener('change', function(e) {
        if (e.target.classList.contains('obat-select') || 
            e.target.classList.contains('aturan-minum-select') || 
            e.target.classList.contains('waktu-konsumsi-select')) {
            updateResepObatField();
        }
    });
    
    // Initialize toggle remove buttons
    toggleRemoveButtons();
    
    // Form validation sebelum submit
    document.querySelector('form').addEventListener('submit', function(e) {
        const obatItems = document.querySelectorAll('.obat-item');
        let hasValidObat = false;
        
        obatItems.forEach(item => {
            const namaObat = item.querySelector('.obat-select').value;
            const aturanMinum = item.querySelector('.aturan-minum-select').value;
            const waktuKonsumsi = item.querySelector('.waktu-konsumsi-select').value;
            
            if (namaObat && aturanMinum && waktuKonsumsi) {
                hasValidObat = true;
            }
        });
        
        if (!hasValidObat) {
            e.preventDefault();
            alert('Minimal harus memilih 1 obat beserta aturan minum dan waktu konsumsinya!');
            return false;
        }
        
        // Update hidden field sebelum submit
        updateResepObatField();
    });
});
</script>

