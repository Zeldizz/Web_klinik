<%- include('../partials/admin-layout-header') %>
<%- include('../partials/admin-sidebar') %>

<div id="content">
    <%- include('../partials/admin-top-nav') %>

    <div class="main-content">
        <div class="card shadow-sm">
            <div class="card-header card-header-custom">
                <h5 class="mb-0"><%= title %></h5>
            </div>
            <div class="card-body">
                <form action="<%= action %>" method="POST">
                    <div class="mb-3">
                        <label for="nama" class="form-label">Nama Lengkap</label>
                        <input type="text" class="form-control" id="nama" name="nama" value="<%= patient.nama %>" required>
                    </div>
                    <div class="mb-3">
                        <label for="email" class="form-label">Email</label>
                        <input type="email" class="form-control" id="email" name="email" value="<%= patient.email %>" required>
                    </div>
                    <div class="mb-3">
                        <label for="tanggal_lahir" class="form-label">Tanggal Lahir</label>
                        <input type="date" class="form-control" id="tanggal_lahir" name="tanggal_lahir" value="<%= patient.tanggal_lahir ? new Date(patient.tanggal_lahir).toISOString().split('T')[0] : '' %>" required>
                    </div>
                    <div class="mb-3">
                        <label for="jenis_kelamin" class="form-label">Jenis Kelamin</label>
                        <select class="form-select" id="jenis_kelamin" name="jenis_kelamin" required>
                            <option value="L" <%= (patient.jenis_kelamin === 'L' || patient.jenis_kelamin === 'Laki-laki') ? 'selected' : '' %>>Laki-laki</option>
                            <option value="P" <%= (patient.jenis_kelamin === 'P' || patient.jenis_kelamin === 'Perempuan') ? 'selected' : '' %>>Perempuan</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="alamat" class="form-label">Alamat</label>
                        <textarea class="form-control" id="alamat" name="alamat" rows="3"><%= patient.alamat %></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="no_telepon" class="form-label">No. Telepon</label>
                        <input type="text" class="form-control" id="no_telepon" name="no_telepon" value="<%= patient.no_telepon %>">
                    </div>

                    <div class="d-flex justify-content-end mt-4">
                        <a href="/admin/pasien" class="btn btn-secondary me-2">Batal</a>
                        <button type="submit" class="btn btn-primary">Simpan Perubahan</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/admin-layout-footer') %> 