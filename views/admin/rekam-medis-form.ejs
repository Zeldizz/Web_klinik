        'Oleskan pada area yang sakit', 'Oleskan setelah dibersihkan',
        
        // Tetes Mata/Telinga
        '1 tetes pada mata yang sakit 2x sehari', '1 tetes pada mata yang sakit 3x sehari',
        '2 tetes pada mata yang sakit 2x sehari', '2 tetes pada mata yang sakit 3x sehari',
        '1-2 tetes pada mata yang sakit 4x sehari',
        '2-3 tetes pada telinga yang sakit 2x sehari', '2-3 tetes pada telinga yang sakit 3x sehari',
        
        // Kumur/Gargle
        'Kumur 2x sehari', 'Kumur 3x sehari', 'Kumur setelah makan',
        'Kumur dengan 15ml selama 30 detik',
        
        // Khusus
        'Sesuai kebutuhan (bila perlu)', 'Sekali pakai', 'Sampai habis',
