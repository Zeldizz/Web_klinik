<%- include('partials/header') %>

<div class="container section-padding-sm">
    <!-- Header Section -->
    <div class="row justify-content-center mb-5">
        <div class="col-md-8">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="display-6 fw-bold mb-2 text-primary">Edit Profil</h1>
                    <p class="text-muted mb-0">Perbarui informasi pribadi Anda</p>
                </div>
                <div>
                    <a href="/profile" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>
                        Kembali
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Form -->
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card card-modern">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-4">
                        <div class="me-3">
                            <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 rounded-circle" style="width: 60px; height: 60px;">
                                <i class="fas fa-user-edit text-primary" style="font-size: 1.5rem;"></i>
                            </div>
                        </div>
                        <div>
                            <h4 class="fw-bold mb-1">Ubah Data Profil</h4>
                            <p class="text-muted mb-0">Pastikan informasi yang Anda masukkan akurat dan terbaru</p>
                        </div>
                    </div>

                    <form action="/profile/edit" method="POST">
                        <!-- Email Field (Disabled) -->
                        <div class="mb-4">
                            <label for="email" class="form-label fw-semibold">
                                <i class="fas fa-envelope me-2 text-muted"></i>
                                Alamat Email
                            </label>
                            <input type="email" class="form-control form-control-lg" id="email" name="email" value="<%= patientData.email %>" disabled>
                            <div class="form-text">
                                <i class="fas fa-info-circle me-1"></i>
                                Email tidak dapat diubah karena digunakan untuk login
                            </div>
                        </div>

                        <!-- Full Name -->
                        <div class="mb-4">
                            <label for="nama" class="form-label fw-semibold">
                                <i class="fas fa-user me-2 text-muted"></i>
                                Nama Lengkap
                            </label>
                            <input type="text" class="form-control form-control-lg" id="nama" name="nama" value="<%= patientData.nama %>" required>
                        </div>

                        <!-- KTP and Phone -->
                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label for="no_ktp" class="form-label fw-semibold">
                                    <i class="fas fa-id-card me-2 text-muted"></i>
                                    No. KTP
                                </label>
                                <input type="text" class="form-control form-control-lg" id="no_ktp" name="no_ktp" value="<%= patientData.no_ktp %>" required maxlength="16" pattern="[0-9]{16}">
                                <div class="form-text">Masukkan 16 digit nomor KTP</div>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label for="no_telepon" class="form-label fw-semibold">
                                    <i class="fas fa-phone me-2 text-muted"></i>
                                    No. Telepon
                                </label>
                                <input type="tel" class="form-control form-control-lg" id="no_telepon" name="no_telepon" value="<%= patientData.no_telepon %>" required>
                                <div class="form-text">Contoh: 08123456789</div>
                            </div>
                        </div>

                        <!-- Gender and Birth Date -->
                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label for="jenis_kelamin" class="form-label fw-semibold">
                                    <i class="fas fa-venus-mars me-2 text-muted"></i>
                                    Jenis Kelamin
                                </label>
                                <select class="form-select form-select-lg" id="jenis_kelamin" name="jenis_kelamin" required>
                                    <option value="">Pilih jenis kelamin</option>
                                    <option value="Laki-laki" <%= patientData.jenis_kelamin === 'Laki-laki' ? 'selected' : '' %>>Laki-laki</option>
                                    <option value="Perempuan" <%= patientData.jenis_kelamin === 'Perempuan' ? 'selected' : '' %>>Perempuan</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label for="tanggal_lahir" class="form-label fw-semibold">
                                    <i class="fas fa-calendar me-2 text-muted"></i>
                                    Tanggal Lahir
                                </label>
                                <input type="date" class="form-control form-control-lg" id="tanggal_lahir" name="tanggal_lahir" value="<%= patientData.tanggal_lahir.toISOString().split('T')[0] %>" required>
                            </div>
                        </div>

                        <!-- Address -->
                        <div class="mb-4">
                            <label for="alamat" class="form-label fw-semibold">
                                <i class="fas fa-map-marker-alt me-2 text-muted"></i>
                                Alamat Lengkap
                            </label>
                            <textarea class="form-control" id="alamat" name="alamat" rows="4" required placeholder="Masukkan alamat lengkap Anda..."><%= patientData.alamat %></textarea>
                            <div class="form-text">Sertakan RT/RW, Kelurahan, Kecamatan, Kota/Kabupaten</div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex justify-content-between align-items-center mt-5 pt-4 border-top">
                            <div>
                                <small class="text-muted">
                                    <i class="fas fa-shield-alt me-1"></i>
                                    Data Anda akan disimpan dengan aman
                                </small>
                            </div>
                            <div>
                                <a href="/profile" class="btn btn-outline-secondary me-3">
                                    <i class="fas fa-times me-2"></i>
                                    Batal
                                </a>
                                <button type="submit" class="btn btn-primary btn-lg">
                                    <i class="fas fa-save me-2"></i>
                                    Simpan Perubahan
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>

<script>
// Form validation and enhancement
document.addEventListener('DOMContentLoaded', function() {
    const form = document.querySelector('form');
    const ktpInput = document.getElementById('no_ktp');
    const phoneInput = document.getElementById('no_telepon');
    const birthDateInput = document.getElementById('tanggal_lahir');
    
    // KTP validation - only numbers
    ktpInput.addEventListener('input', function() {
        this.value = this.value.replace(/[^0-9]/g, '');
        if (this.value.length > 16) {
            this.value = this.value.slice(0, 16);
        }
    });
    
    // Phone validation - only numbers and + at start
    phoneInput.addEventListener('input', function() {
        let value = this.value;
        if (value.startsWith('+')) {
            value = '+' + value.slice(1).replace(/[^0-9]/g, '');
        } else {
            value = value.replace(/[^0-9]/g, '');
        }
        this.value = value;
    });
    
    // Birth date validation - not future date
    birthDateInput.addEventListener('change', function() {
        const selectedDate = new Date(this.value);
        const today = new Date();
        
        if (selectedDate > today) {
            alert('Tanggal lahir tidak boleh di masa depan');
            this.value = '';
        }
    });
    
    // Form submission validation
    form.addEventListener('submit', function(e) {
        const ktp = ktpInput.value;
        const phone = phoneInput.value;
        
        if (ktp.length !== 16) {
            e.preventDefault();
            alert('Nomor KTP harus 16 digit');
            ktpInput.focus();
            return;
        }
        
        if (phone.length < 10) {
            e.preventDefault();
            alert('Nomor telepon minimal 10 digit');
            phoneInput.focus();
            return;
        }
    });
});
</script>
